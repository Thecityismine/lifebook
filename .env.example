# Firebase client configuration from the development project's registered web app.
# These values identify the Firebase project and are embedded in the client bundle.
# Never place service-account credentials, private keys, or administrative secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Set to true only after the project's private Storage bucket and rules are active.
EXPO_PUBLIC_FIREBASE_STORAGE_ENABLED=false
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: used only if Firebase Analytics is added for web later.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
