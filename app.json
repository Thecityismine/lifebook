{
  "expo": {
    "name": "LifeBook",
    "slug": "lifebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifebook",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1120",
    "ios": {
      "bundleIdentifier": "com.thecityismine.lifebook.dev",
      "icon": "./assets/expo.icon",
      "backgroundColor": "#0C1120"
    },
    "android": {
      "package": "com.thecityismine.lifebook.dev",
      "adaptiveIcon": {
        "backgroundColor": "#0C1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1120",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LifeBook to choose a photo for someone in your private family archive.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7",
          "defaultChannel": "lifebook-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
