rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedParent() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedSelf(userId) {
      return verifiedParent() && request.auth.uid == userId;
    }

    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function privacySettingsPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/settings/privacy;
    }

    function isFamilyMember(familyId) {
      return verifiedParent() && exists(memberPath(familyId));
    }

    function isFamilyManager(familyId) {
      return isFamilyMember(familyId)
        && (get(memberPath(familyId)).data.role == 'owner'
          || (get(memberPath(familyId)).data.role == 'guardian'
            && (!exists(privacySettingsPath(familyId))
              || get(privacySettingsPath(familyId)).data.guardianCanEdit == true)));
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId) && get(memberPath(familyId)).data.role == 'owner';
    }

    function validFamily(data) {
      return data.keys().hasAll(['name', 'ownerId', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'ownerId', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.ownerId == request.auth.uid
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validOwnerMember(data, userId) {
      return data.keys().hasAll(['userId', 'role', 'displayName', 'email', 'joinedAt'])
        && data.keys().hasOnly(['userId', 'role', 'displayName', 'email', 'joinedAt'])
        && data.userId == userId
        && data.role == 'owner'
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.joinedAt == request.time;
    }

    function validManagedProfile(data, familyId) {
      return data.keys().hasAll([
          'familyId',
          'firstName',
          'relationship',
          'managed',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId',
          'firstName',
          'relationship',
          'managed',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.familyId == familyId
        && data.firstName is string
        && data.firstName.size() >= 2
        && data.firstName.size() <= 80
        && data.relationship in ['My child', 'Grandchild', 'Other']
        && data.managed == true
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validPersonFields(data, familyId) {
      return data.keys().hasAll([
          'familyId',
          'firstName',
          'lastName',
          'nickname',
          'birthday',
          'notes',
          'tags',
          'photoUrl',
          'photoPath',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId',
          'firstName',
          'lastName',
          'nickname',
          'birthday',
          'notes',
          'tags',
          'photoUrl',
          'photoPath',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.familyId == familyId
        && data.firstName is string
        && data.firstName.size() >= 1
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() <= 80
        && data.nickname is string
        && data.nickname.size() <= 80
        && data.birthday is string
        && data.birthday.size() <= 10
        && (data.birthday == '' || data.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.notes is string
        && data.notes.size() <= 2000
        && data.tags is list
        && data.tags.size() <= 12
        && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (data.photoPath == null || (data.photoPath is string && data.photoPath.size() <= 512))
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdBy is string
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validRelationshipFields(data, familyId, personId, profileId) {
      return data.keys().hasAll([
          'familyId',
          'personId',
          'profileId',
          'relationshipLabel',
          'notes',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId',
          'personId',
          'profileId',
          'relationshipLabel',
          'notes',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.familyId == familyId
        && data.personId == personId
        && data.profileId == profileId
        && data.relationshipLabel is string
        && data.relationshipLabel.size() >= 1
        && data.relationshipLabel.size() <= 100
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMemoryFields(data, familyId) {
      return data.keys().hasAll([
          'familyId',
          'profileId',
          'title',
          'story',
          'occurredOn',
          'personIds',
          'photoUrl',
          'photoPath',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId',
          'profileId',
          'title',
          'story',
          'occurredOn',
          'personIds',
          'photoUrl',
          'photoPath',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.familyId == familyId
        && data.profileId is string
        && data.profileId.size() >= 1
        && data.profileId.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.story is string
        && data.story.size() <= 5000
        && data.occurredOn is string
        && data.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.personIds is list
        && data.personIds.size() <= 20
        && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (data.photoPath == null || (data.photoPath is string && data.photoPath.size() <= 512))
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdBy is string
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validChapterFields(data, familyId) {
      return data.keys().hasAll([
          'familyId',
          'profileId',
          'title',
          'description',
          'startsOn',
          'endsOn',
          'iconKey',
          'colorKey',
          'memoryIds',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId',
          'profileId',
          'title',
          'description',
          'startsOn',
          'endsOn',
          'iconKey',
          'colorKey',
          'memoryIds',
          'archivedAt',
          'createdBy',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.familyId == familyId
        && data.profileId is string
        && data.profileId.size() >= 1
        && data.profileId.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 3000
        && data.startsOn is string
        && (data.startsOn == '' || data.startsOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.endsOn is string
        && (data.endsOn == '' || data.endsOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.iconKey in ['school', 'sport', 'home', 'travel', 'milestone', 'other']
        && data.colorKey in ['violet', 'mint', 'sun', 'blush', 'sky']
        && data.memoryIds is list
        && data.memoryIds.size() <= 100
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdBy is string
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validReminderFields(data, familyId) {
      return data.keys().hasAll([
          'familyId', 'profileId', 'title', 'notes', 'dueOn', 'timeOfDay', 'kind', 'personId',
          'completedAt', 'archivedAt', 'createdBy', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId', 'profileId', 'title', 'notes', 'dueOn', 'timeOfDay', 'kind', 'personId',
          'completedAt', 'archivedAt', 'createdBy', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.familyId == familyId
        && data.profileId is string
        && data.profileId.size() >= 1
        && data.profileId.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.notes is string
        && data.notes.size() <= 2000
        && data.dueOn is string
        && data.dueOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timeOfDay is string
        && (data.timeOfDay == '' || data.timeOfDay.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && data.kind in ['birthday', 'appointment', 'school', 'activity', 'milestone', 'other']
        && data.personId is string
        && data.personId.size() <= 128
        && (data.personId == ''
          || exists(/databases/$(database)/documents/families/$(familyId)/people/$(data.personId)))
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdBy is string
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPrivacySettings(data, familyId) {
      return data.keys().hasAll([
          'familyId', 'defaultVisibility', 'guardianCanEdit', 'updatedBy',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'familyId', 'defaultVisibility', 'guardianCanEdit', 'updatedBy',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.familyId == familyId
        && data.defaultVisibility == 'family'
        && data.guardianCanEdit is bool
        && data.updatedBy is string
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validAuditEvent(data, familyId) {
      return data.keys().hasAll([
          'familyId', 'eventType', 'actorId', 'summary', 'schemaVersion', 'createdAt'
        ])
        && data.keys().hasOnly([
          'familyId', 'eventType', 'actorId', 'summary', 'schemaVersion', 'createdAt'
        ])
        && data.familyId == familyId
        && data.eventType in [
          'privacy_settings_updated',
          'family_invite_created',
          'family_invite_revoked',
          'family_invite_accepted',
          'member_role_changed',
          'member_removed',
          'ownership_transferred'
        ]
        && data.actorId == request.auth.uid
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 240
        && data.schemaVersion == 1
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isVerifiedSelf(userId)
        && request.resource.data.keys().hasAll([
          'userId',
          'displayName',
          'email',
          'familyId',
          'activeProfileId',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'displayName',
          'email',
          'familyId',
          'activeProfileId',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.familyId is string
        && request.resource.data.activeProfileId == null
        && request.resource.data.onboardingComplete == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerifiedSelf(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeProfileId', 'onboardingComplete', 'updatedAt'])
        && request.resource.data.activeProfileId is string
        && request.resource.data.onboardingComplete == true
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /consents/{consentId} {
        allow read: if isSelf(userId);
        allow create: if isVerifiedSelf(userId)
          && request.resource.data.keys().hasAll(['userId', 'version', 'guardianConfirmed', 'source', 'acceptedAt'])
          && request.resource.data.keys().hasOnly(['userId', 'version', 'guardianConfirmed', 'source', 'acceptedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.version == consentId
          && request.resource.data.guardianConfirmed == true
          && request.resource.data.source == 'onboarding'
          && request.resource.data.acceptedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /families/{familyId} {
      allow create: if verifiedParent() && validFamily(request.resource.data);
      allow read: if isFamilyMember(familyId);
      allow update: if isFamilyOwner(familyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        allow create: if verifiedParent()
          && memberId == request.auth.uid
          && getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid
          && validOwnerMember(request.resource.data, memberId);
        allow update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isFamilyOwner(familyId);
        allow create, update, delete: if false;
      }

      match /profiles/{profileId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyManager(familyId) && validManagedProfile(request.resource.data, familyId);
        allow update: if isFamilyManager(familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /people/{personId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyManager(familyId)
          && validPersonFields(request.resource.data, familyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.archivedAt == null
          && request.resource.data.photoUrl == null
          && request.resource.data.photoPath == null;
        allow update: if isFamilyManager(familyId)
          && validPersonFields(request.resource.data, familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'nickname',
            'birthday',
            'notes',
            'tags',
            'photoUrl',
            'photoPath',
            'archivedAt',
            'updatedAt'
          ]);
        allow delete: if false;

        match /relationships/{profileId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isFamilyManager(familyId)
            && validRelationshipFields(request.resource.data, familyId, personId, profileId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && exists(/databases/$(database)/documents/families/$(familyId)/profiles/$(profileId));
          allow update: if isFamilyManager(familyId)
            && validRelationshipFields(request.resource.data, familyId, personId, profileId)
            && request.resource.data.familyId == resource.data.familyId
            && request.resource.data.personId == resource.data.personId
            && request.resource.data.profileId == resource.data.profileId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'relationshipLabel',
              'notes',
              'updatedAt'
            ]);
          allow delete: if false;
        }
      }

      match /memories/{memoryId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyManager(familyId)
          && validMemoryFields(request.resource.data, familyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.archivedAt == null
          && request.resource.data.photoUrl == null
          && request.resource.data.photoPath == null
          && exists(/databases/$(database)/documents/families/$(familyId)/profiles/$(request.resource.data.profileId));
        allow update: if isFamilyManager(familyId)
          && validMemoryFields(request.resource.data, familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'story',
            'occurredOn',
            'personIds',
            'photoUrl',
            'photoPath',
            'archivedAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /chapters/{chapterId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyManager(familyId)
          && validChapterFields(request.resource.data, familyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.archivedAt == null
          && exists(/databases/$(database)/documents/families/$(familyId)/profiles/$(request.resource.data.profileId));
        allow update: if isFamilyManager(familyId)
          && validChapterFields(request.resource.data, familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'startsOn',
            'endsOn',
            'iconKey',
            'colorKey',
            'memoryIds',
            'archivedAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyManager(familyId)
          && validReminderFields(request.resource.data, familyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.completedAt == null
          && request.resource.data.archivedAt == null
          && exists(/databases/$(database)/documents/families/$(familyId)/profiles/$(request.resource.data.profileId));
        allow update: if isFamilyManager(familyId)
          && validReminderFields(request.resource.data, familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'notes', 'dueOn', 'timeOfDay', 'kind', 'personId',
            'completedAt', 'archivedAt', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isFamilyMember(familyId);
        allow create: if settingId == 'privacy'
          && isFamilyOwner(familyId)
          && validPrivacySettings(request.resource.data, familyId)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if settingId == 'privacy'
          && isFamilyOwner(familyId)
          && validPrivacySettings(request.resource.data, familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guardianCanEdit', 'updatedBy', 'updatedAt']);
        allow delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyOwner(familyId) && validAuditEvent(request.resource.data, familyId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
